# Streamlit Community Cloud Secrets
# ================================
# Copy this file to secrets.toml and fill in values.
# secrets.toml is git-ignored and must NEVER be committed.
#
# In Streamlit Community Cloud, add these via:
#   App → Settings → Secrets

# Demo password gate. Set to a non-empty string to enable.
# Remove or leave empty to disable auth (local dev default).
DEMO_PASSWORD = ""
